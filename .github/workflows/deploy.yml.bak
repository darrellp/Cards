name: Deploy Avalonia WASM to GitHub Pages

on:
  push:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      # 1. This compiles your solution inside the cloud runner
      - name: Publish App
        run: dotnet publish -c Release

      # 2. This creates the required .nojekyll file in the compiled folder
      - name: Create .nojekyll
        run: touch SolitaireUI/SolitaireUI.Browser/bin/Release/net10.0-browser/publish/wwwroot/.nojekyll

      # 3. This points directly to your project's wwwroot folder
      - name: Upload Artifacts
        uses: actions/upload-pages-artifact@v3
        with:
          path: 'SolitaireUI/SolitaireUI.Browser/bin/Release/net10.0-browser/publish/wwwroot'

      # 4. This pushes it live to your URL
      - name: Deploy to GitHub Pages
        uses: actions/deploy-pages@v4
