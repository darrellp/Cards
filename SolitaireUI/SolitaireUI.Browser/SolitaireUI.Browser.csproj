<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Browser"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SolitaireUI\SolitaireUI.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- ViewLocator resolves views via reflection (Type.GetType by string name).
             Preserve SolitaireUI's types so the trimmer doesn't remove them in the
             browser/WASM publish. -->
        <TrimmerRootAssembly Include="SolitaireUI" />
    </ItemGroup>
</Project>
