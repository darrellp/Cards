<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:SolitaireUI.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
			 x:Class="SolitaireUI.Views.CardBackSelectView"
			 x:DataType="vm:CardBackSelectViewModel">

	<UserControl.Resources>
		<SolidColorBrush x:Key="OkayButtonBackground">#1976D2</SolidColorBrush>
		<SolidColorBrush x:Key="OkayButtonForeground">White</SolidColorBrush>
		<SolidColorBrush x:Key="OkayButtonBorder">#1565C0</SolidColorBrush>
		<SolidColorBrush x:Key="OkayButtonHoverBackground">#1565C0</SolidColorBrush>
		<SolidColorBrush x:Key="OkayButtonPressedBackground">#0D47A1</SolidColorBrush>
		<SolidColorBrush x:Key="CancelButtonBackground">#D32F2F</SolidColorBrush>
		<SolidColorBrush x:Key="CancelButtonForeground">White</SolidColorBrush>
		<SolidColorBrush x:Key="CancelButtonBorder">#C62828</SolidColorBrush>
		<SolidColorBrush x:Key="CancelButtonHoverBackground">#C62828</SolidColorBrush>
		<SolidColorBrush x:Key="CancelButtonPressedBackground">#B71C1C</SolidColorBrush>

		<ControlTheme x:Key="OkayButtonTheme" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource OkayButtonBackground}"/>
			<Setter Property="Foreground" Value="{StaticResource OkayButtonForeground}"/>
			<Setter Property="BorderBrush" Value="{StaticResource OkayButtonBorder}"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Padding" Value="30,10"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="4">
						<ContentPresenter Name="contentPresenter"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  Padding="{TemplateBinding Padding}"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
					</Border>
				</ControlTemplate>
			</Setter>
			<Style Selector="^:pointerover /template/ Border#border">
				<Setter Property="Background" Value="{StaticResource OkayButtonHoverBackground}"/>
			</Style>
			<Style Selector="^:pressed /template/ Border#border">
				<Setter Property="Background" Value="{StaticResource OkayButtonPressedBackground}"/>
			</Style>
		</ControlTheme>

		<ControlTheme x:Key="CancelButtonTheme" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource CancelButtonBackground}"/>
			<Setter Property="Foreground" Value="{StaticResource CancelButtonForeground}"/>
			<Setter Property="BorderBrush" Value="{StaticResource CancelButtonBorder}"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Padding" Value="30,10"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="4">
						<ContentPresenter Name="contentPresenter"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  Padding="{TemplateBinding Padding}"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
					</Border>
				</ControlTemplate>
			</Setter>
			<Style Selector="^:pointerover /template/ Border#border">
				<Setter Property="Background" Value="{StaticResource CancelButtonHoverBackground}"/>
			</Style>
			<Style Selector="^:pressed /template/ Border#border">
				<Setter Property="Background" Value="{StaticResource CancelButtonPressedBackground}"/>
			</Style>
		</ControlTheme>
	</UserControl.Resources>

	<Grid Background="{DynamicResource SystemControlBackgroundBaseHighBrush}">
		<StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Spacing="20">
			<!-- Title -->
			<TextBlock Text="Select Card Back"
					   FontSize="36"
					   FontWeight="Bold"
					   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
					   HorizontalAlignment="Center"
					   Margin="0,20,0,0" />

			<!-- Card backs grid/scroll panel -->
			<Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
					BorderBrush="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
					BorderThickness="1"
					CornerRadius="8"
					Padding="20"
					Margin="20,0,20,0"
					MinHeight="400">
				<ScrollViewer>
					<ItemsControl ItemsSource="{Binding AvailableCardBacks}" x:Name="CardBacksItemsControl">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button Width="150" Height="220" Padding="5" 
										Command="{Binding $parent[ItemsControl].DataContext.SelectCardBackCommand}"
										CommandParameter="{Binding Index}"
										Margin="5">
									<Button.Content>
										<Border x:Name="SelectionBorder"
												BorderBrush="Transparent"
												BorderThickness="4"
												CornerRadius="6"
												Padding="1">
											<Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
													BorderThickness="2"
													CornerRadius="4">
												<Image Source="{Binding Image}" Stretch="UniformToFill" />
											</Border>
										</Border>
									</Button.Content>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Border>

			<!-- Buttons -->
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,0,0,20">
				<Button Content="Okay"
						Command="{Binding OkayCommand}"
						Theme="{StaticResource OkayButtonTheme}" />
				<Button Content="Cancel"
						Command="{Binding CancelCommand}"
						Theme="{StaticResource CancelButtonTheme}" />
			</StackPanel>
		</StackPanel>
	</Grid>
</UserControl>
