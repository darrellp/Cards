<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SolitaireUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SolitaireUI.Views.GameSelectView"
             x:DataType="vm:GameSelectViewModel">

    <Grid Background="{DynamicResource SystemControlBackgroundBaseHighBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="30">
            <TextBlock Text="Select a Solitaire Game"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="30"
                    MinWidth="400">
                <StackPanel Spacing="20">
                    <TextBlock Text="Available Games:"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                               Margin="0,0,0,10" />

                    <ListBox ItemsSource="{Binding AvailableGames}"
                             SelectedItem="{Binding SelectedGame}"
                             Height="200"
                             Padding="5"
                             Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                          FontSize="16"
                                          Padding="8,5"
                                          Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="Start Game"
                            Command="{Binding StartGameCommand}"
                            HorizontalAlignment="Center"
                            Padding="30,10"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                            BorderThickness="1" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>