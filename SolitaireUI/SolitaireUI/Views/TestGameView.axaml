<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:controls="using:SolitaireUI.Controls"
                xmlns:vm="using:SolitaireUI.ViewModels"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
                x:Class="SolitaireUI.Views.TestGameView"
                x:DataType="vm:TestGameViewModel"
                Focusable="True"
                KeyDown="OnKeyDown">

    <Grid RowDefinitions="*,Auto">
        <!-- Main game area -->
        <Panel Grid.Row="0">
            <Grid Background="Green">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="100">
                    <StackPanel Spacing="10">
                        <TextBlock Text="From" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"/>
                        <controls:StackControl Stack="{Binding From}" 
                                               FaceUp="true" 
                                               CardWidth="140" 
                                               CardHeight="180" 
                                               Width="140" />
                    </StackPanel>
                    
                    <StackPanel Spacing="10">
                        <TextBlock Text="To" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"/>
                        <controls:StackControl Stack="{Binding To}" 
                                               FaceUp="true" 
                                               CardWidth="140" 
                                               CardHeight="180" 
                                               Width="140" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Canvas IsHitTestVisible="False">
                <controls:StackControl Stack="{Binding TempDragStack}"
                                        IsVisible="{Binding IsDragging}"
                                        FaceUp="true"
                                        CardWidth="140"
                                        CardHeight="180"
                                        Width="140"
                                        Canvas.Left="{Binding DragX}"
                                        Canvas.Top="{Binding DragY}"/>
            </Canvas>

            <Border IsVisible="{Binding IsGameOverDialogVisible}"
                    Background="#88000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border Background="{Binding GameOverBackground}"
                        BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="20" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding GameOverMessage}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <Button Content="OK"
                                HorizontalAlignment="Center"
                                IsDefault="True"
                                Command="{Binding ResetGameCommand}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Panel>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="#1b5e20" BorderBrush="#0d47a1" BorderThickness="0,2,0,0" Padding="10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Back to Game Selection"
                        Command="{Binding BackToGameSelectCommand}"
                        Padding="15,5"
                        FontSize="14" />
                <TextBlock DockPanel.Dock="Left"
                           Text="Test Game"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="10,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>

</UserControl>